# Xcode
# .noindex keeps Spotlight out of derived data — mds indexing the 88 MB
# models and every build artifact was measurably contaminating benchmark runs.
build/
build.noindex/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Vendored agent skills — restore from skills-lock.json
.agents/

branding
/qa-assets/

# Models + QA media are staged by scripts/fetch-models.sh, as on Android.
naqi/Resources/Models/
naqiTests/Fixtures/

# Thmanyah Sans: the licence allows embedding in the app but forbids hosting the
# font files, and this repo is public. Copy regular/medium/bold .otf into NaqiShared/Fonts locally.
NaqiShared/Fonts/
