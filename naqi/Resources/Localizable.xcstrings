    "dlg_long_job_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقدَّر مدة هذا الفيديو بنحو ‏%1$@ على الأقل. أوصِل الهاتف بالشاحن — يواصل نقي العمل في الخلفية، لكن الهاتف سيبقى مشغولًا طوال هذه المدة، ولا يمكن إيقاف المهمة مؤقتًا، بل إلغاؤها فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video is estimated at ~%1$@ at least. Keep the phone plugged in — Naqi keeps working in the background, but the phone will be busy the whole time and the job can't be paused, only cancelled."
          }
        }
      }
    },
    "dlg_long_job_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
