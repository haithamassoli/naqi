    "dlg_long_job_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقدَّر مدة هذا الفيديو بنحو ‏%1$@ على الأقل. أبقِ التطبيق مفتوحًا لأسرع نتيجة. وإذا أوقف iOS المهمة، فسيستأنفها نقي عندما يكون الهاتف قيد الشحن وفي وضع الخمول."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video is estimated at ~%1$@ at least. Keep Naqi open for the fastest result. If iOS pauses the job, Naqi will resume it when your phone is charging and idle."
          }
        }
      }
    },
    "dlg_long_job_title" : {
      "extractionState" : "manual",
