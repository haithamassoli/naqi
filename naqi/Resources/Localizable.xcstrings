    "dlg_delete_original_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى النسخة المُفلترة (%1$@) في مكتبة الصور. أمّا الفيديو الأصلي فسيُحذف من هذا الجهاز ولا يمكن استرجاعه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filtered copy (%1$@) stays in your photo library. The original video will be removed from this device and can't be recovered."
          }
        }
      }
    },
    "dlg_delete_original_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حذف الملف الأصلي — احذفه من المعرض بدلًا من ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't delete the original — remove it from your gallery instead."
          }
        }
      }
    },
