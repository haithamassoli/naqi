    "about_privacy_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يجمع نقي أي بيانات، ولا يستخدم تحليلات أو مكتبات طرف ثالث، ولا يتطلب حساباً. ولا يحتوي على أي كود شبكة إطلاقاً — ضع الجهاز في وضع الطيران وسيعمل كما هو تماماً. تعمل كل النماذج على هذا الجهاز. والفيديو الذي تختاره يُفتح للقراءة فقط ولا يُعدَّل أبداً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naqi collects no data, has no analytics, uses no third-party SDKs and needs no account. It contains no networking code at all — put the device in Airplane Mode and it works exactly the same. Every model runs on this device. The video you pick is opened read-only and is never modified."
          }
        }
      }
    },
    "about_privacy_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء يغادر هذا الجهاز"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing leaves this device"
          }
        }
      }
    },
