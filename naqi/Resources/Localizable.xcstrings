    "about_license" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حقوق النشر © ٢٠٢٦ هيثم عسولي. جميع الحقوق محفوظة. للاستخدام الشخصي غير التجاري فقط؛ لا يُسمح بإعادة التوزيع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2026 Haitham Assoli. All rights reserved. Personal, non-commercial use only; redistribution is not permitted."
          }
        }
      }
    },
